    <string name="ui_controls_bottom">Tlačítka dole</string>
    <string name="ui_controls_bottom_desc">Tlačítka mikrofonu, zvuku a sdílení i přepínač Kanály/Chat se zobrazují dole na obrazovce, v dosahu palce.</string>
    <string name="ui_language">Jazyk</string>
    <string name="ui_language_phone">Jazyk telefonu</string>
    <string name="ui_admin_desc">Nabídka uživatele navíc umožní přesun do jiného kanálu, vykopnutí z kanálu či serveru a zákaz přístupu. O povolení rozhoduje server: bez příslušného oprávnění akci odmítne.</string>

    <!-- Settings › Advanced -->
    <string name="relay_title">Připojení videa</string>
    <string name="relay_desc">Přenosy probíhají přímo mezi vámi a druhou stranou. V některých sítích potřebují prostředníka (server TURN). Pokud ho máte, zadejte ho zde.</string>
    <string name="relay_address">Zprostředkující server (turn:host:port)</string>
    <string name="relay_user">Uživatelské jméno pro zprostředkující server</string>
    <string name="relay_password">Heslo pro zprostředkující server</string>
    <string name="relay_only">Vždy přes zprostředkující server</string>
    <string name="advanced_file_port">Pokud přenos souborů na serveru používá jiný port (nenačítají se obrázky a avatary), můžete ho nastavit pro daný oblíbený server v části Pokročilé.</string>
    <string name="passwords_title">Hesla kanálů</string>
    <string name="passwords_desc">Do kanálů s uloženým heslem vstoupíte jedním klepnutím. Hesla se ukládají zašifrovaně v tomto telefonu.</string>
    <string name="passwords_forget">Zapomenout uložená hesla</string>
    <string name="passwords_forgotten">Hesla zapomenuta.</string>
    <string name="identity_title">Identita TeamSpeak</string>
    <string name="identity_desc">Podle identity vás servery rozpoznávají a přiřazují vám skupiny a oprávnění. Uchovejte si její kopii nebo použijte identitu z jiné aplikace TeamSpeak.</string>
    <string name="identity_wipe">Smazat</string>
    <string name="identity_export">Exportovat</string>
    <string name="identity_import">Importovat</string>
    <string name="identity_imported">Importováno. Identita se použije od příštího připojení.</string>
    <string name="identity_saved">Uloženo. Soubor uchovejte na místě, kam máte přístup jen vy.</string>
    <string name="identity_wiped">Smazáno. Při příštím připojení se vytvoří nová identita.</string>
    <string name="identity_export_title">Export identity</string>
    <string name="identity_export_subtitle">Uchovejte ji v soukromí</string>
    <string name="identity_save_file">Uložit do souboru</string>
    <string name="identity_export_what">Soubor obsahuje vaši identitu: kdokoli ho má, může na všech serverech vystupovat jako vy, se všemi vašimi skupinami a oprávněními, například právy správce serveru. Nikdo vás od sebe nerozezná.</string>
    <string name="identity_export_where">Uložte ho na místo, kam máte přístup jen vy, například do tohoto telefonu nebo na soukromý disk. Neposílejte ho v chatu ani e-mailem a nezveřejňujte ho. Otevře ho aplikace TeamSpeak i PocketTS na jiném telefonu.</string>
    <string name="identity_wipe_title">Smazat vaši identitu?</string>
    <string name="identity_wipe_what">Identita tohoto telefonu se smaže a při příštím připojení se vytvoří nová. Pro každý server pak budete někdo nový: vaše skupiny, oprávnění ani další práva přiřazená původní identitě (například práva správce) se nepřenesou.</string>
    <string name="identity_wipe_back">Obnovit ji lze pouze z exportované kopie. Pokud ji budete chtít znovu použít, zvolte Zrušit a nejprve ji exportujte.</string>
    <string name="identity_import_title">Import identity</string>
    <string name="identity_import_subtitle">Z aplikace TeamSpeak</string>
    <string name="identity_import_desc">Vložte identitu exportovanou z aplikace TeamSpeak nebo vyberte uložený soubor (.ini). Od příštího připojení nahradí identitu tohoto telefonu.</string>
