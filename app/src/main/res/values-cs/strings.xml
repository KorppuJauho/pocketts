    <string name="playback_event_sounds">Zvuky událostí</string>
    <string name="playback_event_sounds_desc">Krátké zvuky při příchodu do kanálu a odchodu z něj, při zprávách, šťouchnutích a přenosech i při použití tlačítek mikrofonu a zvuku.</string>
