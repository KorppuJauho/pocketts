    <!-- Settings › General -->
    <string name="avatar_title">Profilový obrázek</string>
    <string name="avatar_change">Změnit</string>
    <string name="avatar_desc">Ostatní ho uvidí na tomto serveru. Velikost se přizpůsobí na 320 × 320.</string>
    <string name="general_floating_ptt">Plovoucí tlačítko pro mluvení</string>
    <string name="general_floating_ptt_desc">V režimu mluvení po stisku zůstává dole na obrazovce PocketTS kulaté tlačítko, takže můžete mluvit i při procházení chatu. Tlačítko nad ostatními aplikacemi má samostatné nastavení níže.</string>
    <string name="general_overlay_ptt">Tlačítko pro mluvení nad ostatními aplikacemi</string>
    <string name="general_overlay_ptt_desc">V režimu mluvení po stisku se po přepnutí do jiné aplikace zobrazí kulaté tlačítko (v samotném PocketTS se nezobrazuje). Podržením mluvíte, přetažením ho přesunete. Android si jednou vyžádá povolení zobrazovat PocketTS nad ostatními aplikacemi.</string>
    <string name="general_volume_ptt">Mluvení tlačítky hlasitosti</string>
    <string name="general_volume_ptt_desc">V režimu mluvení po stisku můžete při zobrazené aplikaci mluvit podržením tlačítka hlasitosti (místo změny hlasitosti).</string>
    <string name="general_headset_ptt">Mluvení tlačítkem na sluchátkách</string>
    <string name="general_headset_ptt_desc">V režimu mluvení po stisku zahájíte mluvení stisknutím tlačítka na sluchátkách a dalším stisknutím ho ukončíte. Funguje i s vypnutou obrazovkou. Při zapnutí této volby tlačítko neovládá přehrávání hudby.</string>
    <string name="general_call_mute">Ztlumit během telefonních hovorů</string>
    <string name="general_call_mute_desc">Při vyzvánění nebo zahájení telefonního hovoru se vypne mikrofon i zvuk (včetně zvuku sledovaného přenosu). Po skončení hovoru se znovu zapnou. Sdílený přenos se pozastaví, aby diváci hovor neviděli. Co jste ztlumili ručně, zůstane ztlumené.</string>
    <string name="general_updates">Kontrolovat aktualizace</string>
    <string name="general_updates_desc">PocketTS se jednou denně dotáže na GitHub, zda vyšla nová verze, a upozorní na ni na připojovací obrazovce. Žádné údaje o vás se neodesílají.</string>
    <string name="general_screen_on">Ponechat obrazovku zapnutou</string>
    <string name="general_screen_on_desc">Obrazovka nezhasne, dokud jste připojeni a aplikace je otevřená. Při sdílení nebo sledování přenosu zůstává zapnutá vždy.</string>
    <string name="general_spacers">Povolit vstup do oddělovacích kanálů</string>
    <string name="general_spacers_desc">Klepnutím na oddělovač (dělicí čáru nebo nadpis v seznamu kanálů) do něj vstoupíte jako do běžného kanálu. Některé servery ho používají jako AFK kanál. Při vypnutí této volby do oddělovače omylem nevstoupíte.</string>
    <string name="history_title">Historie chatu</string>
    <!-- %1$s is how many days (history_days), %2$s how many lines (history_lines) -->
    <string name="history_desc">Zprávy v kanálech, soukromé zprávy a události příchodů a odchodů se ukládají zašifrovaně v tomto telefonu. Při připojení ke stejnému serveru se znovu zobrazí: za poslední %1$s, nejvýše %2$s na konverzaci. Šťouchnutí se neukládají.</string>
